#!/bin/sh

set -eu

files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.c' '*.h')

if [ -z "$files" ]; then
    exit 0
fi

echo "Checking C formatting..."

# Check each staged C/header file.
printf '%s\n' "$files" |
while IFS= read -r file; do
    if [ -f "$file" ]; then
        if ! clang-format --dry-run --Werror "$file"; then
            echo "Formatting required: $file"
            echo "Run 'make format', then stage the changes."
            exit 1
        fi
    fi
done
